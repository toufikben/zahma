# ===== زحمة — قالب الإعدادات =====
# انسخ إلى .env واملأ القيم. لا تُرفع .env إلى git.

# قاعدة البيانات (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://zahma:zahma@localhost:5432/zahma

# --- مفاتيح المصادر ---
MAPBOX_TOKEN=
TOMTOM_KEY=

# --- تنبيهات التشغيل ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- سلوك المجمّع ---
# الفاصل الزمني بين المسحات (دقائق) في الذروة
SCAN_INTERVAL_PEAK_MIN=30
# الفاصل في غير الذروة
SCAN_INTERVAL_OFFPEAK_MIN=120
# الفاصل للعمق (TomTom Flow) في الذروة
DEEP_INTERVAL_PEAK_MIN=5
# نسبة الحصة التي لا نتجاوزها (0.0-1.0)
QUOTA_SOFT_LIMIT=0.90
# المنطقة الزمنية للعرض
TZ_NAME=Africa/Algiers
